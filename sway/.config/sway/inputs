### Input configuration
#
# Example configuration:
#
#   input "2:14:SynPS/2_Synaptics_TouchPad" {
#       dwt enabled
#       tap enabled
#       natural_scroll enabled
#       middle_emulation enabled
#   }

input * {
	xkb_layout de
} 

input "1267:12918:ELAN07B9:00_04F3:3276_Touchpad" {
    natural_scroll enabled
    accel_profile adaptive
    pointer_accel .4
    scroll_factor .9
    dwt enabled
    tap enabled
    tap_button_map lrm
  }
